

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'collection-advanced-filters.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
{% # theme-check-disable-next-line UnknownFilter %}
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div
      class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% liquid
        assign category_options = ''
        assign brand_options = ''

        for product in collection.products
          for tag in product.tags
            assign tag_value = tag | strip
            if tag_value contains 'categoria:'
              assign tag_name = tag_value | split: ':' | last | strip
              unless category_options contains tag_name
                assign category_options = category_options | append: '|' | append: tag_name
              endunless
            elsif tag_value contains 'category:'
              assign tag_name = tag_value | split: ':' | last | strip
              unless category_options contains tag_name
                assign category_options = category_options | append: '|' | append: tag_name
              endunless
            elsif tag_value contains 'marca:'
              assign tag_name = tag_value | split: ':' | last | strip
              unless brand_options contains tag_name
                assign brand_options = brand_options | append: '|' | append: tag_name
              endunless
            elsif tag_value contains 'brand:'
              assign tag_name = tag_value | split: ':' | last | strip
              unless brand_options contains tag_name
                assign brand_options = brand_options | append: '|' | append: tag_name
              endunless
            endif
          endfor

          if product.vendor != blank
            assign vendor_name = product.vendor | strip
            unless brand_options contains vendor_name
              assign brand_options = brand_options | append: '|' | append: vendor_name
            endunless
          endif
        endfor
      %}

      <div
        class="collection-advanced-filters"
        data-collection-filter-panel
        data-category-options="{{ category_options | escape_attr }}"
        data-brand-options="{{ brand_options | escape_attr }}"
      >
        <div class="collection-advanced-filters__header">
          <h3>Filtrar</h3>
          <button type="button" class="collection-advanced-filters__clear" data-clear-filters>
            Limpiar
          </button>
        </div>

        <div class="collection-advanced-filters__groups">
          <div class="collection-advanced-filters__group">
            <h4>Categorías</h4>
            <div data-filter-group="category"></div>
          </div>

          <div class="collection-advanced-filters__group">
            <h4>Marcas</h4>
            <div data-filter-group="brand"></div>
          </div>
        </div>
      </div>

      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% assign products_per_page = 24 %}

      {% if section.settings.enable_infinite_scroll == false %}
        {% assign products_per_page = section.settings.products_per_page %}
      {% endif %}

      {% paginate collection.products by products_per_page %}
        {% capture children %}
          {% for product in collection.products %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              data-product-tags="{{ product.tags | join: ',' | escape_attr }}"
              data-product-brand="{{ product.vendor | escape_attr }}"
              ref="cards[]"
            >
              {% content_for 'block',
                type: '_product-card',
                id: 'product-card',
                closest.product: product,
                product_view_context: 'collection'
              %}
            </li>
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: collection.products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll
        %}
      {% endpaginate %}
    </div>
  </results-list>
</collection-component>

{% style %}
  .collection-advanced-filters {
    grid-column: 1 / -1;
    margin: 0 0 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.12);
    border-radius: 0.75rem;
    background: rgba(var(--color-background-rgb), 0.6);
  }

  .collection-advanced-filters__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .collection-advanced-filters__header h3,
  .collection-advanced-filters__group h4 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .collection-advanced-filters__clear {
    border: 0;
    background: transparent;
    color: rgba(var(--color-foreground-rgb), 0.8);
    cursor: pointer;
    font: inherit;
    padding: 0;
  }

  .collection-advanced-filters__clear:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .collection-advanced-filters__groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem 1.5rem;
  }

  .collection-advanced-filters__group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .collection-advanced-filters__group > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .collection-advanced-filters__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    cursor: pointer;
    color: rgba(var(--color-foreground-rgb), 0.85);
    font-size: 0.95rem;
  }

  .collection-advanced-filters__item input {
    accent-color: rgb(var(--color-foreground-rgb));
  }

  .collection-advanced-filters__empty {
    margin: 0;
    color: rgba(var(--color-foreground-rgb), 0.6);
  }

  @media screen and (max-width: 749px) {
    .collection-advanced-filters {
      padding: 0.9rem 0.9rem 1rem;
    }

    .collection-advanced-filters__header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
